# SUNOVATE local development configuration. Copy to `.env` (git-ignored).
# Placeholder values only. Never put real credentials, tokens, or internal URLs here.

# --- API (apps/api reads this file or the process environment) ---
APP_ENV=development
LOG_LEVEL=INFO
# Hard security locks. The API refuses to start if any value is changed to an unsafe state.
PRIVATE_DATA_MODE=true
PUBLIC_INDEXING_ENABLED=false
EXTERNAL_AI_DATA_EGRESS_ENABLED=false
EXTERNAL_AGENT_ACCESS_ENABLED=false
TELEMETRY_DATA_EGRESS_ENABLED=false
# simulated | postgres (ADR-007, ADR-015). simulated = in-memory SIMULATED_DATA, lost on restart.
# postgres = runtime reads/writes DATABASE_URL (run `pnpm db:migrate` and `pnpm db:seed` first).
DATA_BACKEND=simulated
# Used by the postgres runtime, migrations, seed, and /health/database. Matches docker-compose.yml.
# Scheme: postgresql+asyncpg or postgresql+psycopg (plain postgresql is rejected). Local placeholder only.
DATABASE_URL=postgresql+asyncpg://sunovate:sunovate_local@localhost:5432/sunovate

# Development login for SIMULATED users. Must be false outside development.
DEV_AUTH_ENABLED=true
# Leave empty to generate an ephemeral secret per process (tokens expire on restart).
DEV_AUTH_SECRET=
DEV_AUTH_TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# Providers: only development implementations exist; production integrations are disabled.
DOCUMENT_PROVIDER=local
LOCAL_STORAGE_PATH=./infrastructure/local/documents
IDENTITY_PROVIDER=development
NOTIFICATION_PROVIDER=disabled
AI_PROVIDER=development_extractive
EMBEDDING_PROVIDER=disabled
HERMES_MODE=development
HERMES_MAX_CLASSIFICATION=RESTRICTED

# Deadline threshold for DUE_SOON (OPEN QUESTION OQ-15).
DEADLINE_DUE_SOON_DAYS=7

# --- Docker Compose (local PostgreSQL + pgvector) ---
POSTGRES_DB=sunovate
POSTGRES_USER=sunovate
POSTGRES_PASSWORD=sunovate_local

# --- Web (apps/web, server-side only) ---
NEXT_TELEMETRY_DISABLED=1
SUNOVATE_API_URL=http://localhost:8000
