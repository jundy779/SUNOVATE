# Copy to a file outside Git or to deploy/demo/demo.env (git-ignored).
# Placeholder values only. Use SIMULATED_DATA and do not activate external access
# before mentor and TIK/security approval.
APP_ENV=development
LOG_LEVEL=INFO
DEMO_HTTP_PORT=8080
DEMO_ORIGIN=http://127.0.0.1:8080

POSTGRES_DB=sunovate
POSTGRES_USER=sunovate
POSTGRES_PASSWORD=CHANGE_ME_DEMO_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://sunovate:CHANGE_ME_DEMO_DATABASE_PASSWORD@postgres:5432/sunovate

DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
